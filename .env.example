# TerraMind — Variáveis de ambiente
# Copie para `.env` e preencha os segredos (nunca comite o `.env`).
# Dentro do Docker Compose use os nomes dos serviços (`postgres`, `erp-mcp`, etc.);
# rodando fora do Docker na sua máquina, troque pelos equivalentes em `localhost`.

# Banco de dados e base vetorial (contrato 13)
DATABASE_URL=postgresql://terramind:terramind@postgres:5432/terramind
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Endereços entre serviços (contratos 4, 10, 11, 13 e 14)
AGENTS_URL=http://agents:8000
CONHECIMENTO_URL=http://conhecimento:8010
MONITOR_URL=http://monitor:8020
ERP_MCP_URL=http://erp-mcp:8030/mcp

# Modelos de IA — OpenAI direto via LiteLLM (decisão A3)
OPENAI_API_KEY=
MODEL_AVALIADOR=openai/gpt-6-luna
MODEL_AGRONOMICO=openai/gpt-6-luna
MODEL_OPERACIONAL=openai/gpt-6-luna
MODEL_SUPERVISOR=openai/gpt-6-luna
REASONING_EFFORT=low        # gpt-6-luna: none | low | medium | high (não aceita minimal)

# Canal de notificação e aprovação (contratos 6 e 7)
CHANNEL=telegram            # telegram | painel
# Só UM processo pode fazer polling por token (erro `Conflict`): use um bot por ambiente
# (seu PC, VM) ou deixe CHANNEL=painel nos demais.
TELEGRAM_BOT_TOKEN=
GERENTE_CHAT_ID=
APPROVAL_TIMEOUT_MIN=30

# Monitor de clima (Edison)
MONITOR_MODE=replay         # live | replay
MONITOR_INTERVAL_MIN=30

# Runtime Python
PYTHONUTF8=1

