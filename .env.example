# TerraMind — Variáveis de ambiente
# Copie para `.env` e preencha os segredos (nunca comite o `.env`).
# Dentro do Docker Compose use os nomes dos serviços (`postgres`, `erp-mcp`, etc.);
# rodando fora do Docker na sua máquina, troque pelos equivalentes em `localhost`.

# Banco de dados e base vetorial (contrato 13)
DATABASE_URL=postgresql://terramind:terramind@postgres:5432/terramind
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Agrofit (Embrapa AgroAPI): busca de produto no cadastro de bula (E5). Consumer Key/Secret da aplicação na loja.
AGROFIT_CLIENT_ID=
AGROFIT_CLIENT_SECRET=

# Endereços entre serviços (contratos 4, 10, 11, 13 e 14)
AGENTS_URL=http://agents:8000
AGENTS_TOKEN=                # F3, contrato 23: segredo do painel para responder planos (vazio = sem exigência). Gere: python -c "import secrets;print(secrets.token_urlsafe(32))"
PAINEL_ADMIN_EMAIL=          # F3: primeiro gerente, criado na subida se ainda não há usuário
PAINEL_ADMIN_SENHA=          # tire daqui depois do primeiro acesso e troque a senha em /conta
PAINEL_COOKIE_SEGURO=        # 1 quando o painel é servido em HTTPS
CONHECIMENTO_URL=http://conhecimento:8010
MONITOR_URL=http://monitor:8020
ERP_MCP_URL=http://erp-mcp:8030/mcp

# Modelos de IA — OpenAI direto via LiteLLM (decisão A3)
OPENAI_API_KEY=
MODEL_AVALIADOR=openai/gpt-6-luna
MODEL_AGRONOMICO=openai/gpt-6-luna
MODEL_OPERACIONAL=openai/gpt-6-luna
MODEL_SUPERVISOR=openai/gpt-6-luna
MODEL_BULA=openai/gpt-6-luna          # G4: Pergunte à bula
FATOR_ATRASO_DIA=0.02       # G5: estimativa provisória até o E7 trazer o fator de atraso no conhecimento
REASONING_EFFORT=low        # gpt-6-luna: none | low | medium | high (não aceita minimal)

# Canal de notificação e aprovação (contratos 6 e 7)
CHANNEL=painel              # painel | telegram | whatsapp. O painel funciona sem token; os outros pedem as credenciais abaixo
# Só UM processo pode fazer polling por token (erro `Conflict`): use um bot por ambiente
# (seu PC, VM) ou deixe CHANNEL=painel nos demais.
TELEGRAM_BOT_TOKEN=
GERENTE_CHAT_ID=          # gerente PADRÃO: só vale para fazenda sem gerente com chat em erp.gerentes (contrato 20)
TELEGRAM_CHATS_BULA=        # G4: chats extras (além do gerente) que podem perguntar à bula, ex.: 123,456
APPROVAL_TIMEOUT_MIN=30

# WhatsApp (CHANNEL=whatsapp, F4): passo a passo, modelos e webhook em docs/whatsapp.md
WHATSAPP_TOKEN=             # token permanente da Cloud API (usuário do sistema)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=        # confere a assinatura do webhook; sem ele o webhook recusa tudo
WHATSAPP_VERIFY_TOKEN=      # você inventa; o mesmo vai no cadastro do webhook na Meta
WHATSAPP_GERENTE_TELEFONE=  # gerente PADRÃO (só para fazenda sem gerente com telefone em erp.gerentes)
WHATSAPP_NUMEROS_BULA=      # números extras que podem perguntar à bula, ex.: 5564999998888,5511999997777
WHATSAPP_TEMPLATE_APROVACAO=terramind_aprovacao
WHATSAPP_TEMPLATE_AVISO=terramind_aviso
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_API_VERSION=v22.0  # confira a versão vigente da Graph API

# Previsão fora do incidente: agenda (G2), janela da OS (G3) e clima do relatório (G7)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Dashboard de perda evitada (G1)
SAFRA_INICIO=               # AAAA-MM-DD; vazio = 1º de julho do ano-safra corrente
PRECO_HA_SAFRA=             # R$/ha por safra; com valor, a tela mostra o retorno sobre a assinatura

# Monitor de clima (Edison)
MONITOR_INTERVAL_MIN=30
LIMIAR_CHUVA_MM=20
LIMIAR_VENTO_KMH=11        # vento a 2 m (altura da barra); equivale a 15 km/h a 10 m
LIMIAR_UMIDADE_MIN_PCT=50
LIMIAR_RAJADA_KMH=15       # rajada a 2 m; equivale a 20 km/h a 10 m (estimativa do E7)
LIMIAR_DELTA_T_MIN_C=2
LIMIAR_DELTA_T_MAX_C=8
LIMIAR_INVERSAO_VENTO_MAX_KMH=2
JANELA_RISCO_H=48
OPEN_METEO_API_KEY=         # opcional: plano pago do Open-Meteo (customer-api); vazio usa a API gratuita

# Runtime Python
PYTHONUTF8=1

